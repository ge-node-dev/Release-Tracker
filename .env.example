# ---------------------------------------------------------------------------
# .env.local — production credentials. Used by `yarn build` / `yarn start`,
# and read by `yarn db:sync` to pull catalog data out of prod.
# ---------------------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> Data API
SUPABASE_URL=https://<prod-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<prod publishable key>
SUPABASE_SERVICE_ROLE_KEY=<prod service role key>

# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# Percent-encode the password. Only `yarn db:sync` reads this.
SUPABASE_DB_URL=postgresql://postgres.<prod-ref>:<password>@<host>:5432/postgres

REVALIDATION_SECRET=<random string, must differ per environment>

CLOUDINARY_URL=https://api.cloudinary.com/v1_1/<cloud-name>
CLOUDINARY_API_KEY=<cloudinary api key>
CLOUDINARY_API_SECRET=<cloudinary api secret>

NEXT_PUBLIC_SITE_URL=https://<production-domain>

# ---------------------------------------------------------------------------
# .env.development.local — local Docker stack. Overrides .env.local under
# `yarn dev`, and is what the `test:*` scripts run against.
#
# Copy the Publishable and Secret keys from the `supabase start` output. They are the same on
# every machine, but are left out here because secret scanning rejects them in a committed file.
# Run `supabase status` to print them again.
# ---------------------------------------------------------------------------

# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=<Publishable key from `supabase start`>
# SUPABASE_SERVICE_ROLE_KEY=<Secret key from `supabase start`>
# REVALIDATION_SECRET=local-dev-secret
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
